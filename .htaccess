RewriteEngine On

# Enforce HTTPS (HTTP to HTTPS 301 Redirect)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect legacy /blogs/ URLs to /patient-education/
RewriteRule ^blogs?/understanding-osteoporotic-spine-fractures.*$ /patient-education/osteoporotic-spine-fractures [R=301,L]
RewriteRule ^blogs?/(.+)$ /patient-education/$1 [R=301,L]
RewriteRule ^blogs?/?$ /patient-education [R=301,L]

# Define 404 Error Document
ErrorDocument 404 /404.php

# Redirect /index or /index.php to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.php)?[\s\?] [NC]
RewriteRule ^index(\.php)?$ / [R=301,L]

# 1. Redirect /about or /about.php to /profile
RewriteRule ^about(\.php)?$ /profile [R=301,L]

# Explicit 301 redirects for legacy .php pillar endpoints
RewriteRule ^brain-tumor-removal-surgery\.php$ /brain-tumor-removal-surgery [R=301,L]
RewriteRule ^brain-aneurysm-treatment\.php$ /brain-aneurysm-treatment [R=301,L]
RewriteRule ^spine-fracture-treatment\.php$ /spine-fracture-treatment [R=301,L]

# Redirect old spine health article slug to new slug
RewriteRule ^patient-education/spine-health-as-you-age--tips-to-maintain-a-strong-back-after-50/?$ /patient-education/spine-health-after-50 [R=301,L]

# 2. Redirect external GET requests with .php to clean extensionless URLs (301 Redirect)
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Resolve the blogs landing page before Apache treats the blog directory as a URL
RewriteRule ^patient-education/?$ patient-education.php [L,QSA]

# 4. Rewrite clean URLs back to .php internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]

# 5. Pass through existing files & directories (images, css, js)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 6. Fallback any non-existent URLs to 404.php
RewriteRule ^ 404.php [L]

# ==============================================================================
# PERFORMANCE OPTIMIZATIONS (PageSpeed Insights: Compression & Browser Caching)
# ==============================================================================

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(php|html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Browser Caching Headers (Leverage Browser Cache)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images, SVG, WebP, Favicons
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Web Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|css|js|woff2?|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
